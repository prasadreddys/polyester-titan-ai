# Local server binding; use a protected reverse proxy for remote deployments.
HOST=127.0.0.1
PORT=3000

# Target Polyester Testnet API host
POLYESTER_API_HOST=https://api.testnet.polyester.com

# Polyester API Credentials (obtained from the Polyester Testnet Web App)
POLYESTER_API_KEY_ID=your_testnet_api_key_id
POLYESTER_API_PRIVATE_KEY=your_testnet_private_key_hex
POLYESTER_ACCOUNT_ID=your_testnet_account_id

# Optional: Local/Docker Python 3.11+ FastAPI service
FASTAPI_BACKEND_URL=http://localhost:8000

# Connection Settings
POLYESTER_REQUEST_TIMEOUT_MS=7000
POLYESTER_MAX_RETRIES=2

# Safety Invariants (Must remain false / true)
BOT_AUTO_TRADE_ENABLED=false
BOT_DRY_RUN=true
